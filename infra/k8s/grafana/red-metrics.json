{
  "title": "Ripplemark RED Metrics",
  "uid": "ripplemark-red",
  "schemaVersion": 39,
  "version": 1,
  "timezone": "browser",
  "refresh": "30s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Rate",
      "targets": [
        {
          "expr": "sum by (job) (rate(http_requests_total{namespace=\"ripplemark\"}[1m]))",
          "legendFormat": "{{job}}"
        }
      ],
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "Errors (5xx)",
      "targets": [
        {
          "expr": "sum by (job) (rate(http_requests_total{namespace=\"ripplemark\",status=~\"5..\"}[1m]))",
          "legendFormat": "{{job}}"
        }
      ],
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 }
    },
    {
      "type": "timeseries",
      "title": "Duration p95",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, job) (rate(http_request_duration_seconds_bucket{namespace=\"ripplemark\"}[5m])))",
          "legendFormat": "{{job}}"
        }
      ],
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 }
    }
  ]
}
