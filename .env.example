# Shared platform settings
POSTGRES_DB=ripplemark
POSTGRES_USER=ripplemark
POSTGRES_PASSWORD=ripplemark
POSTGRES_PORT=5432

MONGO_INITDB_DATABASE=ripplemark
MONGO_PORT=27017

REDIS_PORT=6379
NATS_PORT=4222

TOPOLOGY_PORT=3001
ANALYSIS_PORT=8000
REGISTRY_PORT=8001
AUTH_GATEWAY_PORT=3000
WEB_APP_PORT=4200

JWT_SECRET=change-me-in-dev
SECRET_KEY=change-me-for-django
CORS_ORIGINS=*

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Service URLs
TOPOLOGY_SERVICE_URL=http://localhost:3001
ANALYSIS_SERVICE_URL=http://localhost:8000
REGISTRY_SERVICE_URL=http://localhost:8001
AUTH_GATEWAY_URL=http://localhost:3000
REGISTRY_PROXY_USERNAME=local-ui-demo-proxy
REGISTRY_PROXY_TOKEN=localuidemoproxytoken1234567890abcdef12
REQUIRE_GATEWAY_AUTH=false

# Integration test helpers
INTEGRATION_MANAGE_COMPOSE=0
INTEGRATION_AUTH_EMAIL=integration-admin@ripplemark.local
INTEGRATION_AUTH_PASSWORD=IntegrationPass123!
INTEGRATION_AUTH_PG_DSN=postgresql://ripplemark:ripplemark@localhost:5432/ripplemark
