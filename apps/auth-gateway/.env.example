PORT=3000
NODE_ENV=development
LOG_LEVEL=info
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_SECRET=change-me
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgres://auth:auth@localhost:5432/auth_gateway
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_CALLBACK_URL=http://localhost:3000/auth/oauth/google/callback
CORS_ORIGINS=http://localhost:4200
TOPOLOGY_SERVICE_URL=http://localhost:3001
ANALYSIS_SERVICE_URL=http://localhost:8001
REGISTRY_SERVICE_URL=http://localhost:8002
THROTTLE_TTL=60
THROTTLE_LIMIT=100
